# Normalize text and preserve executable/binary artifacts.
* text=auto
*.c text eol=lf
*.h text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.ps1 text eol=crlf
*.md text eol=lf
*.json text eol=lf
*.jsonc text eol=lf
*.cff text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.svg text eol=lf
*.txt text eol=lf
*.exe binary
*.dll binary
*.so binary
*.dylib binary
*.o binary
*.obj binary
*.pdb binary
